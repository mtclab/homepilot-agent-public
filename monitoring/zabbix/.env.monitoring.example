# Monitoring Stack Environment Variables
# Copy this file to .env.monitoring and fill in the values
# Then run: docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d
# And: bash scripts/init-zabbix.sh

# PostgreSQL
ZBX_PG_USER=zabbix
# ZBX_PG_PASSWORD is NOT used — password is read from Docker secret file
# Create monitoring/zabbix/secrets/zabbix_pg_password.txt with your password
ZBX_PG_DB=zabbix

# Zabbix Web UI port (default 8084 to avoid conflicts)
ZBX_WEB_PORT=8084

# Zabbix API URL (used by init-zabbix.sh and MCP server)
ZABBIX_URL=http://localhost:8084

# Timezone
TZ=Europe/Helsinki

# Proxmox monitoring (for "Proxmox VE by HTTP" template)
PVE_URL=https://YOUR_PROXMOX_HOST:8006
PVE_NODE=pve
PVE_TOKEN_ID=monitor@pam!monitoring
PVE_TOKEN_SECRET=CHANGE_ME_proxmox_api_token

# Matrix webhook (for alert notifications)
MATRIX_SERVER=https://matrix.example.com
MATRIX_ROOM_ID=CHANGE_ME_matrix_room_id
MATRIX_TOKEN=CHANGE_ME_matrix_bot_token

# Zabbix admin password — MUST be changed from default "zabbix" on first login!
# Used by init-zabbix.sh to set the admin password via API.
ZBX_ADMIN_PASSWORD=CHANGE_ME_zabbix_admin_password

# Local Zabbix agent (used by init-zabbix.sh to create host)
AGENT_HOSTNAME=CHANGE_ME_hostname
AGENT_IP=CHANGE_ME_host_ip

# TLS/PSK encryption for Zabbix agent communication
# Set to "psk" to enable TLS with pre-shared keys (recommended)
# Set to "unencrypted" to disable encryption (NOT recommended for production)
ZBX_TLSCONNECT=psk
ZBX_TLSACCEPT=psk

# PSK identity strings — must match what's configured in Zabbix UI
# Server identity (for server-to-proxy/active-check connections)
ZBX_TLSCONNECTPSKIDENTITY=zabbix-server

# Agent identity (must match host encryption config in Zabbix UI)
# Use a unique identity per agent: zabbix-agent-<hostname>
ZBX_TLSPSKIDENTITY=zabbix-agent-CHANGE_ME_hostname

# PSK files are auto-generated by monitoring/zabbix/scripts/generate_psk.sh
# They live in monitoring/zabbix/secrets/ (gitignored)
# See monitoring/zabbix/TLS-SETUP.md for full documentation