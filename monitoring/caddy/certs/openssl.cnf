[req]
distinguished_name = req_dn
x509_extensions = v3_req
prompt = no

[req_dn]
CN = homepilot.example.com

[v3_req]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature,keyEncipherment

[alt_names]
DNS.1 = homepilot.example.com
DNS.2 = zabbix.homepilot.example.com
DNS.3 = n8n.homepilot.example.com
DNS.4 = localhost
IP.1 = homepilot.example.com
IP.2 = 127.0.0.1
