# HomePilot Caddy TLS Reverse Proxy
# Docs: monitoring/nginx/README.md
#
# Development: Uses self-signed cert from monitoring/caddy/certs/
# Production:  Replace hp.local with real domain, Caddy auto-HTTPS via ACME

# HomePilot API
hp.local:443, homepilot.local:443 {
	tls /etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key

	reverse_proxy homepilot:8000

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Referrer-Policy strict-origin-when-cross-origin
	}

	# MCP and health endpoints — no auth required
	@mcp path /mcp /mcp/* /health /healthz
	handle @mcp {
		reverse_proxy homepilot:8000
	}

	log {
		output stdout
		format json
	}
}

hp.local:80, homepilot.local:80 {
	redir https://{host}{uri} permanent
}

# Zabbix Web UI
zabbix.hp.local:443, zabbix.local:443 {
	tls /etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key

	reverse_proxy zabbix-web:8080

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	log {
		output stdout
		format json
	}
}

zabbix.hp.local:80, zabbix.local:80 {
	redir https://{host}{uri} permanent
}

# n8n
n8n.hp.local:443, n8n.local:443 {
	tls /etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key

	reverse_proxy n8n:5678

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	log {
		output stdout
		format json
	}
}

n8n.hp.local:80, n8n.local:80 {
	redir https://{host}{uri} permanent
}