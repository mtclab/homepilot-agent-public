# Secrets
.env
.env.monitoring
radicale/data/htpasswd
secrets/*.txt
monitoring/zabbix/secrets/*.txt
!monitoring/zabbix/secrets/.gitkeep

# Bind-mount data dirs (n8n db/keys, radicale, whisper, piper):
# ignore contents, keep .gitkeep placeholders so the dirs exist on clone
data/n8n/*
data/radicale/*
data/whisper/*
data/piper/*
!data/**/.gitkeep

# Radicale calendar data (preserve .gitkeep)
radicale/data/*
!radicale/data/.gitkeep

# Python cache
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# TLS certs (self-signed test certs — regenerate with scripts)
monitoring/caddy/certs/*.crt
monitoring/caddy/certs/*.key
monitoring/caddy/certs/*.pem
AGENTS.md
.opencode/state/
