# Copy to .env and fill in values before docker compose up
# .env is gitignored — never commit secrets
#
# Vars marked [n8n cred] are entered in n8n Settings → Credentials, not passed as env vars.

# ── LLM (external OpenAI-compatible endpoint) ────────────────────────────────
# The agent does NOT run a local model. Point it at any OpenAI-compatible API
# (ollama, llama.cpp server, vLLM, LocalAI, OpenAI, …).
# Base URL must include the /v1 suffix. Also enter this as the Base URL of the
# n8n credential "LLM API" (Settings → Credentials → OpenAI API). Examples:
#   ollama:     http://<ollama-host>:11434/v1
#   llama.cpp:  http://<host>:8080/v1
#   OpenAI:     https://api.openai.com/v1
LLM_BASE_URL=http://<llm-host>:11434/v1
# Model name/tag served by that endpoint (e.g. qwen3:14b, Qwen3-14B, gpt-4o-mini)
LLM_MODEL=qwen3:14b
# [n8n cred] API key for the endpoint → n8n credential "LLM API".
# Keyless local servers (ollama, llama.cpp) ignore it — use any non-empty placeholder.
LLM_API_KEY=<api key or any non-empty placeholder>
# Optional: if a workflow needs embeddings, serve them from an OpenAI-compatible
# endpoint too (e.g. ollama `bge-m3`). No local embedding service is provided.
# EMBEDDING_BASE_URL=http://<ollama-host>:11434/v1
# EMBEDDING_MODEL=bge-m3

# ── HomePilot (external — runs on Proxmox LXC) ───────────────────────────────
# MCP HTTP endpoint (non-secret; used in workflow expressions)
HP_MCP_URL=http://<homelab-ip>:8000/mcp
# [n8n cred] Read-only bearer token — prefer Docker secret (./secrets/hp_mcp_token.txt)
HP_MCP_TOKEN=<read-only token>
# [n8n cred] Read-write bearer token — prefer Docker secret (./secrets/hp_mcp_token_rw.txt)
HP_MCP_TOKEN_RW=<read-write token>
# Webhook URL that HomePilot POSTs artifact events to (set in HomePilot .env as HP_EVENTS_WEBHOOK_URL)
HP_EVENTS_WEBHOOK_URL=http://<n8n-lan-ip>:5678/webhook/artifact-proposed
# [n8n cred] Shared secret validating incoming artifact webhooks → n8n credential "HP Webhook Secret"
# Generate: openssl rand -hex 32
# Also set HP_EVENTS_WEBHOOK_SECRET=<same value> in the HomePilot deployment
HP_WEBHOOK_SECRET=<generate: openssl rand -hex 32>

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://<public-or-lan-ip>:5678/
# n8n encryption key — prefer Docker secret (./secrets/n8n_encryption_key.txt).
N8N_ENCRYPTION_KEY=<32-byte-hex>
# API key for workflow import script (create in n8n Settings → API)
N8N_API_KEY=<n8n api key>
# Basic auth (only needed if exposing n8n port; access via reverse proxy is preferred)
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=<strong password>

# ── SearXNG ──────────────────────────────────────────────────────────────────
# SearXNG secret key — prefer Docker secret (./secrets/searxng_secret_key.txt).
SEARXNG_SECRET_KEY=<32-byte-hex>

# ── Radicale (CalDAV) ────────────────────────────────────────────────────────
# Credentials stored in Docker secret: ./secrets/radicale_htpasswd.txt
# Generate with: scripts/setup-credentials.sh
# Or manually: htpasswd -Bc secrets/radicale_htpasswd.txt admin
RADICALE_USER=admin

# ── Telegram ────────────────────────────────────────────────────────────────
# [n8n cred] Bot token from BotFather → n8n credential "Telegram Bot"
TELEGRAM_BOT_TOKEN=<token from BotFather>
# Your Telegram user ID (non-secret; controls which chat the bot sends to)
TELEGRAM_ALLOWED_USER_ID=<your telegram user id>

# ── Matrix (optional) ───────────────────────────────────────────────────────
# Non-secret homeserver URL and room ID (used in workflow expressions)
MATRIX_HOMESERVER=https://<your-homeserver>
MATRIX_USER=@bot:<homeserver>
# [n8n cred] Access token → n8n credential "Matrix Bot" (HTTP Bearer Auth)
MATRIX_ACCESS_TOKEN=<token>
MATRIX_ROOM_ID=!<room-id>:<homeserver>

# ── Voice (optional — use compose profile: --profile voice) ──────────────────
# Whisper STT endpoint (inside Docker network)
WHISPER_URL=http://whisper:8000
# Piper TTS HTTP endpoint (inside Docker network — piper provides HTTP /api/tts on port 5000)
PIPER_URL=http://piper:5000
# [n8n cred] Shared secret for voice webhook header auth → n8n credential "Voice Webhook Secret"
# Generate: openssl rand -hex 32
# Callers must send header: x-webhook-secret: <this value>
VOICE_WEBHOOK_SECRET=<generate: openssl rand -hex 32>

# ── Timezone ─────────────────────────────────────────────────────────────────────────
TZ=Etc/UTC